{
  "name": "lopad",
  "private": true,
  "version": "0.0.1",
  "description": "LOPAD - 2D top-down roguelike action (PC web). Phaser 3 + TypeScript + Vite.",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"data/**/*.json\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"data/**/*.json\" \"*.ts\""
  },
  "dependencies": {
    "phaser": "~3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.3.1",
    "vitest": "^5.0.3"
  }
}
